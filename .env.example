# AI — Gemini API
GEMINI_API_KEY=AIza...

# Model tier strategy (xem TASK-035 trong TASKS.md)
# Mặc định tất cả là flash-lite. Khi đã verify model availability, upgrade:
#   - LITE    → OCR đơn giản + chatbot Q&A (rẻ, nhanh)
#   - DEFAULT → Claim agent (LangGraph) — cần reasoning ổn định
#   - PRO     → OCR handwriting / multi-doc / bbox (mạnh nhất)
GEMINI_MODEL_LITE=gemini-3.1-flash-lite
GEMINI_MODEL_DEFAULT=gemini-3.1-flash-lite
GEMINI_MODEL_PRO=gemini-3.1-flash-lite
# Upgrade khuyến nghị:
# GEMINI_MODEL_DEFAULT=gemini-3.1-flash
# GEMINI_MODEL_PRO=gemini-3.1-pro

# MongoDB
# Mặc định: local MongoDB không auth (cài trên host machine)
MONGODB_URL=mongodb://localhost:27017
# Nếu dùng docker-compose mongo (port 27018, auth admin:admin):
# MONGODB_URL=mongodb://admin:admin@localhost:27018
MONGODB_DB_NAME=claimflow_db

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MinIO / AWS S3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=claimflow-documents
S3_ENDPOINT_URL=http://localhost:9000

# Qdrant
QDRANT_URL=http://localhost:6333

# Email (Resend)
RESEND_API_KEY=re_...

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
